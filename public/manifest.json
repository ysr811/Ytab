{
  "manifest_version": 3,
  "name": "YTab",
  "version": "1.1",

  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },

  "chrome_url_overrides": {
    "newtab": "index.html"
  },

  "permissions": ["tabs", "storage", "unlimitedStorage"],

  "background": {
    "service_worker": "background.js"
  },

  "commands": {
    "save-all-tabs": {
      "suggested_key": {
        "default": "Alt+C",
        "mac": "Alt+C"
      },
      "description": "Save all open tabs to YTab"
    },
    "save-single-tab": {
      "suggested_key": {
        "default": "Alt+X",
        "mac": "Alt+X"
      },
      "description": "Save current/previous tab to YTab"
    }
  },

  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "24": "icons/icon-24.png",
      "32": "icons/icon-32.png"
    }
  }
}
